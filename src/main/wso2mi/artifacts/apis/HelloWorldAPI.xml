<api xmlns="http://ws.apache.org/ns/synapse" name="HelloWorldAPI" context="/hello">
    <resource methods="GET" uri-template="/world">
        <inSequence>
            <variable name="envVar" expression="get-property('env','sv_hitreports_db_url')" type="STRING"/>
            <variable name="envVarsec"  expression="${wso2-vault('sv_hitreports_db_url')}" type="STRING"/>
            <log category="INFO">
                <message>Environment Variable: ${vars.envVar}</message>
            </log>
            <log category="INFO">
                <message>Environment Variable envVarsec: ${vars.envVarsec}</message>
            </log>
            <payloadFactory media-type="json">
                <format>
                    {
                        "message": "Hello World",
                        "status": "success",
                        "environmentVariable": "${vars.envVar}",
                        "environmentVariable envVarsec": "${vars.envVarsec}"
                    }
                </format>
            </payloadFactory>
            <respond/>
        </inSequence>
        <faultSequence>
            <log category="ERROR">
                <message>Error occurred: ${props.synapse.ERROR_MESSAGE}</message>
            </log>
            <payloadFactory media-type="json">
                <format>
                    {
                        "error": "Internal Server Error",
                        "status": "failed"
                    }
                </format>
            </payloadFactory>
            <respond/>
        </faultSequence>
    </resource>
</api>
